{
  "name": "@zanreal/medusa-product-costs",
  "version": "0.2.0",
  "description": "Medusa v2 plugin for tracking product purchase cost (COGS) per SKU and computing margin, break-even price and net income against a selling price.",
  "keywords": [
    "break-even",
    "cogs",
    "margin",
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "plugin",
    "product-costs",
    "profitability"
  ],
  "homepage": "https://zanreal.com/docs/oss/medusa-product-costs",
  "bugs": {
    "url": "https://github.com/zanreal-labs/medusa-product-costs/issues"
  },
  "license": "MIT",
  "author": "ZanReal <opensource@zanreal.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/medusa-product-costs.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    ".medusa/server",
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@zanreal/medusa-admin-kit": "^0.2.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./admin/components/entity-cost-card": {
      "types": "./dist/entity-cost-card.d.ts",
      "import": "./dist/entity-cost-card.mjs",
      "require": "./dist/entity-cost-card.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && tsup",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:admin": "tsc --noEmit -p src/admin/tsconfig.json",
    "test": "pnpm run typecheck && pnpm run typecheck:admin && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "prepare": "medusa plugin:build && tsup",
    "prepublishOnly": "medusa plugin:build && tsup"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/eslint-plugin": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/orchestration": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "@swc/core": "^1.16.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "i18next": "^23.16.8",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "react-i18next": "^13.5.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.0"
}
